# Copy to .env. Everything is optional: with no keys the app runs in simulated mode.

# --- LLM: mock | gemini | anthropic ---
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Twilio SMS / WhatsApp sandbox ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
# During the demo, send every message to your own phone:
DEMO_PHONE=

# --- Google Calendar (service account) ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# --- Care-team email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CARE_TEAM_EMAIL=

# --- Misc ---
OPENFDA_ENABLED=true
HOSPITAL_NAME=Sunrise Multispeciality Hospital
EMERGENCY_NUMBER=108
FRONTEND_ORIGIN=http://localhost:5173
TICK_SECONDS=5
