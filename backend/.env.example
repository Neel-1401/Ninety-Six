# Copy to backend/.env. Everything is optional: with no keys the whole demo runs in SIMULATED mode.
# Never commit backend/.env or service-account.json.

# demo | production   (demo enables role switching, demo codes, clock fast-forward and reset)
APP_MODE=demo
HOSPITAL_NAME=Sunrise Multispeciality Hospital (fictional)
HOSPITAL_PHONE=+91 80 0000 0000 (demo)
EMERGENCY_NUMBER=108
DISPLAY_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
TICK_SECONDS=2

# --- LLM: mock | anthropic | gemini   (mock = deterministic rules only)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new API keys (404); 3.1 Flash-Lite answers in ~4 s
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Twilio SMS (WhatsApp sandbox optional: TWILIO_CHANNEL=whatsapp, TWILIO_FROM=whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_CHANNEL=sms
# All outbound patient/caregiver messages are redirected here during the demo (E.164, e.g. +9198xxxxxxxx)
DEMO_PHONE=
# Live sends to anything other than DEMO_PHONE are refused unless this is true. Keep false.
ALLOW_LIVE_TO_REAL_RECIPIENTS=false

# --- Google Calendar (service account JSON path; share the calendar with the service-account email)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# --- Care-team alert email (SMTP, e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CARE_TEAM_EMAIL=

# --- Medication information (openFDA, public API, no key)
OPENFDA_ENABLED=true
